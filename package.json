{
  "name": "smart-cs",
  "version": "0.2.1",
  "private": true,
  "description": "AgentDock — 可私有化部署的对话式 Agent 运营平台（仓库代号 smart-cs）",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccOranger/smart-cs.git"
  },
  "homepage": "https://github.com/ccOranger/smart-cs#readme",
  "bugs": {
    "url": "https://github.com/ccOranger/smart-cs/issues"
  },
  "type": "module",
  "workspaces": [
    "frontend",
    "admin-frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:chat": "npm run dev -w frontend",
    "dev:admin": "npm run dev -w admin-frontend",
    "build": "npm run build -w admin-frontend && npm run build -w frontend",
    "build:chat": "npm run build -w frontend",
    "build:admin": "npm run build -w admin-frontend"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
