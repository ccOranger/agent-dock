# 默认由 Git 自动识别文本文件并统一为 LF 入库
* text=auto

# Windows 脚本保持 CRLF，避免 cmd/PowerShell 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本固定 LF
*.sh text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
