# ===== 应用 =====
APP_ENV=development
APP_NAME=smart-cs
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 是否对外暴露 /docs、/redoc、/openapi.json；裸机部署的生产环境建议改为 false
API_DOCS_ENABLED=true
# CORS 白名单（逗号分隔）；生产改为实际域名。单镜像部署前后端同源，无需额外放行 8080
# 嵌入场景还会叠加各自 scenes.allowed_origins（后台配置，保存后立即生效）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ===== 公开接入 / 嵌入 =====
# 匿名聊天限流（按 场景 + user/visitor/ip 分桶）；0 表示关闭该项
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=30
PUBLIC_CHAT_DAILY_QUOTA=2000
# 同一主体同时未结束的流式对话上限
PUBLIC_CHAT_MAX_CONCURRENT=3
# 场景 allowed_origins 的进程内缓存秒数（后台保存会主动失效，通常不用调）
SCENE_ORIGIN_CACHE_TTL=60

# ===== 种子数据 =====
# true：写入演示账号、示例文档与演示动态 Agent（仅用于本地演示，生产保持 false）
SEED_DEMO=false
# 非演示模式的初始管理员（密码留空则随机生成并只打印一次）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# ===== HelloAgents LLM 配置（框架直接读取） =====
LLM_MODEL_ID=gpt-4o
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===== Embedding（hello_agents 记忆/RAG 底层使用，框架直接读取环境变量） =====
# EMBED_MODEL_TYPE: dashscope | local | tfidf
# EMBED_MODEL_NAME 若为空：dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
# EMBED_BASE_URL 不要以 /embeddings 结尾，框架会自动追加 /embeddings
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v2
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== HelloAgents RAG 知识库根目录 =====
RAG_KB_ROOT=./data/knowledge_bases
# 上传原文归档目录（后台下载原文用；Docker 中由 compose 覆盖为 /app/backend/data/doc_archives）
RAG_DOC_ARCHIVE_ROOT=./data/doc_archives
RAG_DEFAULT_NAMESPACE=cs_default
# 单个上传文档大小上限（MB）；docker/nginx.conf 的 client_max_body_size=25m 已留余量
UPLOAD_MAX_SIZE_MB=20

# ===== 数据库 =====
# 本地开发指向 localhost；Docker Compose 部署时由 compose 自动覆盖为 postgres 服务名
DATABASE_URL=postgresql+asyncpg://cs_user:cs_pass@localhost:5432/cs_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
WORKING_MEMORY_TTL=1800

# ===== 向量库 Qdrant（hello_agents 记忆/RAG 统一读取） =====
# QDRANT_URL 留空则回退本地 localhost:6333
QDRANT_URL=http://your-qdrant-host:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_DISTANCE=cosine

# ===== 记忆层 / Neo4j =====
# semantic（语义记忆）硬依赖 Neo4j；未部署 Neo4j 时保持默认（不含 semantic）。
MEMORY_TYPES=working,episodic,perceptual
# 部署 Neo4j 后：将 MEMORY_TYPES 加上 semantic，并填好以下连接：
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change_me
# NEO4J_DATABASE=neo4j

# ===== 鉴权 =====
# Docker Compose 部署必须在仓库根 .env 显式设置 JWT_SECRET（compose 未读到会拒绝启动）
# 生产环境（APP_ENV=prod/production）必须改为 ≥32 字节的随机密钥，否则启动失败
JWT_SECRET=change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
# 反向代理白名单（逗号分隔 IP/CIDR）：仅当直连对端命中时才采信 X-Forwarded-For
# 例：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# ===== 记忆阈值 =====
MEMORY_IMPORTANCE_THRESHOLD=0.6
MEMORY_ACCESS_THRESHOLD=3
MEMORY_DECAY_HALF_LIFE_DAYS=30

# ===== RAG =====
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
# 单次 RAG/记忆检索超时（秒）：Qdrant/embedding 挂起时降级为空，不阻塞对话
RAG_TIMEOUT=15

# ===== 上下文预算 =====
CONTEXT_MAX_TOKENS=8000
CONTEXT_SYSTEM_RESERVE=800
CONTEXT_HISTORY_RESERVE=2000

# ===== 路由 =====
# 路由模型需与 LLM provider 匹配（如 deepseek 专用 deepseek-*）
ROUTER_MODEL=deepseek-flash
ROUTER_CONFIDENCE_THRESHOLD=0.5
# 单条消息最多分发的业务意图数（多意图串行执行上限，1 即关闭多意图）
ROUTER_MAX_INTENTS=2
# 路由判定“不贴合任何 Agent”时（兜底意图，置信度为提示词约定的固定低值）：
# true = 交给兜底 Agent 先应答（避免“你是谁”这类提问直接转人工），false = 仍按低置信转人工
ROUTER_FALLBACK_ANSWER=true

# ===== 链路追踪 =====
# 是否记录每轮对话的 Agent/MCP/工具调用链路（写 request_traces 表）
TRACE_ENABLED=true
# 是否保存工具入参/返回内容（含客户数据，仅截断保存）；关闭则只存工具名/耗时/成败
# 默认 false：需要排障时再打开
TRACE_STORE_PAYLOAD=false
TRACE_PAYLOAD_MAX_CHARS=2000
# 正常应答的采样率（转人工与出错的请求始终全量记录）
TRACE_SAMPLE_RATE=1.0
TRACE_RETENTION_DAYS=30

# ===== 用量计量（chat_events / chat_usage_daily）=====
# Token 估算的整体校准系数：对账时可按供应商账单微调（1.0 = 不校准）
TOKEN_ESTIMATE_FACTOR=1.0
# 后台用量报表单次查询的最大跨度（天），超限返回 400
USAGE_QUERY_MAX_DAYS=366

# ===== License 与版本分层 =====
# 授权文件路径：不存在时静默按社区版运行，对话与社区功能不受影响
LICENSE_FILE=./license.json
# 签发方公钥（Base64 裸 32 字节或 PEM）：留空则无法校验签名，一律社区版
# 公钥由授权方提供；私钥与签发脚本只在私有仓库，不进开源仓库
LICENSE_PUBLIC_KEY=
# 部署指纹：初始化时生成一次并长期保留，授权文件与之不一致会降级为社区版
# 生成：python -c "import uuid;print(uuid.uuid4().hex)"
DEPLOYMENT_ID=

# ===== Docker Compose（docker compose up 时生效） =====
# 数据库容器初始账号（仅首次创建数据卷时生效；修改后需 docker compose down -v 重建）
# 生产必须把 POSTGRES_PASSWORD 改成强密码（生产叠加只校验非空）
POSTGRES_USER=cs_user
POSTGRES_PASSWORD=cs_pass
POSTGRES_DB=cs_db

# 宿主机端口
BACKEND_PORT=8000
WEB_PORT=8080

# 演示数据开关见上方「种子数据」段（SEED_DEMO），此处不再重复

# ===== 生产叠加编排（docker-compose.prod.yml，按需启用） =====
# 使用生产叠加文件时取消注释并填写；同时把上面的 POSTGRES_PASSWORD 改成强密码
# （已有 pgdata 卷修改密码需在库内 ALTER USER），并给 QDRANT_API_KEY 设置非空值。
# DOMAIN=cs.example.com
# DATA_ROOT=/srv/smart-cs
# REDIS_PASSWORD=change-me-alnum
# INIT_ON_START=false
